APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./app.db
TELEGRAM_BOT_TOKEN=
# polling = long polling (исходящие запросы на api.telegram.org; входящий HTTP не нужен)
# webhook = Telegram POST на {APP_BASE_URL}/telegram/webhook + заголовок X-Telegram-Bot-Api-Secret-Token = TELEGRAM_WEBHOOK_SECRET
TELEGRAM_MODE=polling
# Если задан — отклонять webhook без этого секрета (см. GET / на API)
TELEGRAM_WEBHOOK_SECRET=
# Для прода: https://ваш-домен; для локалки: http://localhost:8000 (webhook Telegram нужен HTTPS — см. ngrok).
APP_BASE_URL=http://localhost:8000
# LLM + Whisper: либо OpenRouter (один ключ), либо только OpenAI:
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
OPENAI_API_KEY=
WHISPER_MODEL=openai/whisper-large-v3
CHAT_MODEL=openai/gpt-4o-mini
# Key = только «API key» с https://trello.com/app-key
# Token = строка после кнопки «Token» на той же странице (авторизация). Это НЕ «Secret» приложения.
TRELLO_API_KEY=
TRELLO_API_TOKEN=
DEFAULT_TRELLO_BOARD_ID=
REMINDER_CRON=*/30 * * * *
